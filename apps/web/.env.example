# Where pose model files are downloaded from.
#
# - Unset (dev default): served locally from apps/embedded/public/models/movenet.
# - Set (production default, see .env.production): the app downloads from this
#   CDN base URL and models are NOT bundled into dist/. The host must allow CORS
#   and expose /movenet/<lightning|thunder>/model.json plus its shards.
VITE_KGM_MODELS_BASE_URL=https://cdn.jsdelivr.net/gh/egxn/kinkagami@main/apps/embedded/public/models
