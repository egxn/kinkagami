# Production builds download pose models from a CDN instead of bundling them.
# jsDelivr serves files straight from the public GitHub repo. `@main` follows the
# branch (cached up to ~12h); pin a tag or commit SHA for immutable releases, e.g.
#   https://cdn.jsdelivr.net/gh/egxn/kinkagami@v1.0.0/apps/embedded/public/models
VITE_KGM_MODELS_BASE_URL=https://cdn.jsdelivr.net/gh/egxn/kinkagami@main/apps/embedded/public/models
