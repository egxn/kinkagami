{
  "name": "kinkagami",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "pnpm install && cd backend && poetry install && cd .. && pnpm db:migrate",
    "configure": "bash ./setup/configure.sh",
    "certs:dev": "bash ./setup/dev-cert.sh",
    "hosts:add": "bash ./setup/dev-hosts.sh add",
    "hosts:remove": "bash ./setup/dev-hosts.sh remove",
    "hosts:status": "bash ./setup/dev-hosts.sh status",
    "dev": "pnpm --filter @kgm/embedded dev",
    "dev:embedded": "pnpm --filter @kgm/embedded dev",
    "dev:embedded:frontend": "bash ./setup/run-runtime.sh frontend",
    "dev:embedded:python": "bash ./setup/run-runtime.sh python",
    "dev:embedded:pwa": "pnpm --filter @kgm/embedded dev:pwa",
    "dev:embedded:https": "KGM_DEV_HTTPS=1 pnpm --filter @kgm/embedded dev",
    "dev:web": "pnpm --filter @kgm/web dev",
    "dev:web:cdn": "pnpm --filter @kgm/web dev --mode production",
    "dev:web:https": "KGM_DEV_HTTPS=1 pnpm --filter @kgm/web dev",
    "dev:frontend": "bash ./setup/run-runtime.sh frontend",
    "dev:python": "bash ./setup/run-runtime.sh python",
    "dev:pwa": "pnpm --filter @kgm/embedded dev:pwa",
    "dev:videos": "concurrently \"pnpm server:videos\" \"pnpm dev\"",
    "dev:stream": "concurrently \"bash ./setup/run-stream.sh\" \"pnpm dev\"",
    "build": "pnpm --filter @kgm/embedded build",
    "build:embedded": "pnpm --filter @kgm/embedded build",
    "build:embedded:pwa": "pnpm --filter @kgm/embedded build:pwa",
    "build:web": "pnpm --filter @kgm/web build",
    "build:pwa": "pnpm --filter @kgm/embedded build:pwa",
    "preview": "pnpm --filter @kgm/embedded preview",
    "preview:embedded": "pnpm --filter @kgm/embedded preview",
    "preview:embedded:https": "KGM_DEV_HTTPS=1 pnpm --filter @kgm/embedded preview",
    "preview:embedded:pwa": "pnpm --filter @kgm/embedded preview:pwa",
    "preview:web": "pnpm --filter @kgm/web preview",
    "preview:web:https": "KGM_DEV_HTTPS=1 pnpm --filter @kgm/web preview",
    "check:models-cdn": "pnpm --filter @kgm/web check:models-cdn",
    "preview:pwa": "pnpm --filter @kgm/embedded preview:pwa",
    "start": "pnpm build && pnpm preview",
    "start:embedded": "pnpm build:embedded && pnpm preview:embedded",
    "start:embedded:python": "cd backend && poetry run kgm-camera-backend & bash ./setup/wait-for-port.sh ${KGM_PYTHON_WS_HOST:-127.0.0.1} ${KGM_PYTHON_WS_PORT:-8765} && pnpm preview:embedded",
    "start:embedded:pwa": "pnpm build:embedded:pwa && pnpm preview:embedded:pwa",
    "start:web": "pnpm build:web && pnpm preview:web",
    "start:python": "cd backend && poetry run kgm-camera-backend & bash ./setup/wait-for-port.sh ${KGM_PYTHON_WS_HOST:-127.0.0.1} ${KGM_PYTHON_WS_PORT:-8765} && pnpm preview",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @kgm/core test",
    "test:embedded": "pnpm --filter @kgm/embedded test",
    "test:web": "pnpm --filter @kgm/web test",
    "test:watch": "pnpm --filter @kgm/embedded test:watch",
    "lint": "pnpm -r lint",
    "lint:core": "pnpm --filter @kgm/core lint",
    "lint:embedded": "pnpm --filter @kgm/embedded lint",
    "lint:web": "pnpm --filter @kgm/web lint",
    "lint:ui": "pnpm --filter @kgm/ui lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "server:videos": "pnpm --filter @kgm/embedded server:videos",
    "db:migrate": "pnpm --filter @kgm/embedded db:migrate",
    "db:seeds:generate": "pnpm --filter @kgm/embedded db:seeds:generate",
    "kiosk": "chromium --kiosk --use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-features=TranslateUI --start-fullscreen http://localhost:4173 --auto-open-devtools-for-tabs",
    "pwa:icons": "pnpm --filter @kgm/embedded pwa:icons"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "overrides": {
      "leveldown": "5.6.0"
    }
  }
}
